rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Match ktx_rooms documents
    match /ktx_rooms/{roomId} {
      allow read: if isValidId(roomId);
      allow create, update: if isValidId(roomId)
        && request.resource.data.roomName is string
        && request.resource.data.roomName.size() <= 200;
      allow delete: if false;

      // Subcollection activities
      match /activities/{activityId} {
        allow read: if isValidId(roomId);
        allow create: if isValidId(roomId)
          && request.resource.data.author is string
          && request.resource.data.author.size() <= 100
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000;
        allow update, delete: if false;
      }
    }

    // Fallback default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
